diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index bc1a01647141..e95d80b7be1e 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -10,6 +10,7 @@
 #define pr_fmt(fmt)	"[drm:%s:%d] " fmt, __func__, __LINE__
 
 #include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <linux/dma-buf.h>
 #include <linux/of_irq.h>
 #include <linux/pm_opp.h>
@@ -1164,6 +1165,22 @@ static int dpu_kms_hw_init(struct msm_kms *kms)
 
 	atomic_set(&dpu_kms->bandwidth_ref, 0);
 
+	rc = pm_runtime_resume_and_get(&dpu_kms->pdev->dev);
+	if (rc < 0)
+		goto error;
+
+	/*
+	 * nabu: the bootloader leaves the whole display pipeline (DPU, DSI,
+	 * PHY) running, and bringing the display up on top of that live state
+	 * keeps the first modeset from latching on the NT36523 panel - the DPU
+	 * reports scanout and the DSI accepts commands, but the panel stays
+	 * black.  Power-cycle the display once here: a runtime-PM suspend drops
+	 * the mdss power domain, which resets DPU and DSI together, so bring-up
+	 * starts from a deterministic cold state.  This happens during KMS init,
+	 * long before any modeset.  (Same fix as the 7.2 port, 0502f05d50fc.)
+	 */
+	pm_runtime_put_sync(&dpu_kms->pdev->dev);
+	msleep(50);
 	rc = pm_runtime_resume_and_get(&dpu_kms->pdev->dev);
 	if (rc < 0)
 		goto error;
