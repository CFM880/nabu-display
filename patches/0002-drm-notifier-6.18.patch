+static void dsi_mgr_bridge_enable(struct drm_bridge *bridge)
+{
+	int id = dsi_mgr_bridge_get_id(bridge);
+	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
+	struct msm_dsi *msm_dsi1 = dsi_mgr_get_dsi(DSI_1);
+	struct mipi_dsi_host *host = msm_dsi->host;
+	bool is_bonded_dsi = IS_BONDED_DSI();
+	enum drm_notifier_data notifier_data = MI_DRM_BLANK_UNBLANK;
+	int ret;
+
+	/*
+	 * nabu: the panel bridge is enabled before this callback, so the DSI
+	 * host is started here rather than in pre_enable() (same ordering as
+	 * the 7.2 port).  Starting it earlier leaves the panel receiving its
+	 * init sequence with no video stream, and the first modeset fails to
+	 * latch (black screen).
+	 */
+	if (!(is_bonded_dsi && !IS_MASTER_DSI_LINK(id))) {
+		ret = msm_dsi_host_enable(host);
+		if (ret)
+			pr_err("host %d enable failed %d\n", id, ret);
+		if (is_bonded_dsi && msm_dsi1)
+			msm_dsi_host_enable(msm_dsi1->host);
+	}
+
+	/* Tell the touch driver only once the pipeline is really up. */
+	mi_drm_notifier_call_chain(MI_DRM_EVENT_BLANK, &notifier_data);
+}
