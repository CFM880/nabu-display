--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -352,7 +352,33 @@
 		return;
 	}
 
-	/* the host is started from .enable now, see dsi_mgr_bridge_enable() */
+	/*
+	 * nabu: start the DSI host here, exactly like 6.14 and pmOS' 6.18 do.
+	 * Starting it from .enable (as the 7.2 overlay does) leaves the video
+	 * engine enabled but idle after the first modeset: the controller is
+	 * programmed in video mode, the PLL runs and the DPU streams, yet
+	 * STATUS0 never reports the video engine busy and the panel stays black.
+	 */
+	ret = msm_dsi_host_enable(host);
+	if (ret) {
+		pr_err("%s: enable host %d failed, %d\n", __func__, id, ret);
+		goto host_en_fail;
+	}
+
+	if (is_bonded_dsi && msm_dsi1) {
+		ret = msm_dsi_host_enable(msm_dsi1->host);
+		if (ret) {
+			pr_err("%s: enable host1 failed, %d\n", __func__, ret);
+			goto host1_en_fail;
+		}
+	}
+
+	return;
+
+host1_en_fail:
+	msm_dsi_host_disable(host);
+host_en_fail:
+	dsi_mgr_bridge_power_off(bridge);
 }
 
 void msm_dsi_manager_tpg_enable(void)
